{
  "schema_version": 3,
  "purpose": "operational_status",
  "phase": "runtime",
  "checks": [
    {
      "check_id": "portal_readiness",
      "guarantee_id": "portal_readiness_available",
      "owner": "RenCrow_PORTAL",
      "purpose": "runtime readiness",
      "target": "portal:/health/ready",
      "phase": "runtime",
      "consumer": "runtime readiness",
      "failure_action": "blocked",
      "cost": "low",
      "safety_gate": false,
      "coverage": ["readiness"],
      "executor": {
        "kind": "owner_cli",
        "command_id": "portal-readiness",
        "acquisition": {
          "mode": "owner_self_collect",
          "verification_safe": false,
          "inputs": [{"id": "health_route", "class": "discoverable", "required": true, "source": "owner_operations_api"}]
        }
      },
      "receipt_schema": "rencrow.check-receipt.v1",
      "surfaces": ["browser_ui", "route_security_exposure", "lifecycle_resources"]
    },
    {
      "check_id": "portal_browser_proxy_e2e",
      "guarantee_id": "portal_browser_proxy_verified",
      "owner": "RenCrow_PORTAL",
      "purpose": "diagnostic browser proxy E2E",
      "target": "portal:/?mode=Chat -> /viewer/send",
      "phase": "diagnostic",
      "consumer": "diagnostic browser proxy acceptance",
      "failure_action": "notify",
      "cost": "high",
      "safety_gate": true,
      "coverage": ["canonical_e2e"],
      "executor": {
        "kind": "owner_cli",
        "command_id": "portal-browser-proxy-e2e",
        "acquisition": {
          "mode": "owner_self_collect",
          "verification_safe": true,
          "inputs": [
            {"id": "browser_scenario", "class": "verification_fixture", "required": true, "source": "owner_fixed_fixture"},
            {"id": "canonical_auth", "class": "credential_reference", "required": true, "source": "owner_active_config"}
          ]
        }
      },
      "receipt_schema": "rencrow.check-receipt.v1"
    },
    {
      "check_id": "portal_deploy_identity_chain",
      "guarantee_id": "portal_source_artifact_publication_identity",
      "owner": "RenCrow_PORTAL",
      "purpose": "source, artifact, and publication identity chain",
      "target": "RenCrow_PORTAL source revision -> built artifact -> installed publication",
      "phase": "deploy",
      "consumer": "PORTAL deployment identity gate",
      "failure_action": "blocked",
      "cost": "high",
      "safety_gate": false,
      "coverage": ["source_identity", "artifact_identity", "publication"],
      "executor": {
        "kind": "owner_cli",
        "command_id": "portal-deploy-identity-chain",
        "acquisition": {
          "mode": "owner_self_collect",
          "verification_safe": false,
          "inputs": [
            {"id": "source_identity", "class": "discoverable", "required": true, "source": "ecosystem_catalog"},
            {"id": "artifact_identity", "class": "discoverable", "required": true, "source": "owner_active_config"},
            {"id": "publication_identity", "class": "discoverable", "required": true, "source": "owner_service_manager"}
          ]
        }
      },
      "receipt_schema": "rencrow.check-receipt.v1",
      "surfaces": ["browser_ui", "lifecycle_resources", "publication"]
    },
    {
      "check_id": "portal_runtime_identity_lifecycle_security",
      "guarantee_id": "portal_runtime_identity_lifecycle_security",
      "owner": "RenCrow_PORTAL",
      "purpose": "runtime identity, lifecycle, and security exposure",
      "target": "PORTAL installed artifact -> owner process identity, lifecycle, and protected proxy exposure",
      "phase": "runtime",
      "consumer": "PORTAL runtime lifecycle and security gate",
      "failure_action": "blocked",
      "cost": "high",
      "safety_gate": true,
      "coverage": ["runtime_identity", "lifecycle", "security_exposure"],
      "executor": {
        "kind": "owner_cli",
        "command_id": "portal-runtime-identity-lifecycle-security",
        "acquisition": {
          "mode": "owner_self_collect",
          "verification_safe": false,
          "inputs": [
            {"id": "active_config", "class": "discoverable", "required": true, "source": "owner_active_config"},
            {"id": "service", "class": "discoverable", "required": true, "source": "owner_service_manager"},
            {"id": "proxy_route", "class": "discoverable", "required": true, "source": "owner_operations_api"}
          ]
        }
      },
      "receipt_schema": "rencrow.check-receipt.v1",
      "surfaces": ["browser_ui", "route_security_exposure", "lifecycle_resources", "publication"]
    },
    {
      "check_id": "portal_canonical_actor_e2e",
      "guarantee_id": "portal_canonical_actor_result_with_trace",
      "owner": "RenCrow_PORTAL",
      "purpose": "canonical authenticated browser result and receipt trace",
      "target": "published PORTAL artifact -> authenticated browser user -> CORE canonical route -> user-visible result with receipt trace",
      "phase": "diagnostic",
      "consumer": "PORTAL canonical browser acceptance",
      "failure_action": "blocked",
      "cost": "high",
      "safety_gate": true,
      "coverage": ["canonical_e2e", "actor_result", "receipt_trace"],
      "executor": {
        "kind": "owner_cli",
        "command_id": "portal-canonical-actor-e2e",
        "acquisition": {
          "mode": "owner_self_collect",
          "verification_safe": true,
          "inputs": [
            {"id": "browser_scenario", "class": "verification_fixture", "required": true, "source": "owner_fixed_fixture"},
            {"id": "canonical_auth", "class": "credential_reference", "required": true, "source": "owner_active_config"}
          ]
        }
      },
      "receipt_schema": "rencrow.check-receipt.v1",
      "surfaces": ["browser_ui", "route_security_exposure", "lifecycle_resources", "publication"]
    }
  ]
}
