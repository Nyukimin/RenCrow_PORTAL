{
  "version": 1,
  "steps": [
    {
      "name": "windows-vet",
      "workingDirectory": ".",
      "filePath": "go",
      "arguments": ["vet", "./..."],
      "testFiles": ["*_test.go"]
    },
    {
      "name": "windows-build",
      "workingDirectory": ".",
      "filePath": "go",
      "arguments": ["build", "./..."]
    },
    {
      "name": "release-license-layout",
      "workingDirectory": ".",
      "filePath": "powershell",
      "arguments": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "scripts/tests/release-license-layout.ps1"],
      "testFiles": ["scripts/tests/*.ps1"]
    }
  ]
}
