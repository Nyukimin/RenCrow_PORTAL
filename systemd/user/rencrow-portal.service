[Unit]
Description=RenCrow PORTAL
After=network-online.target rencrow.service
Wants=network-online.target rencrow.service

[Service]
Type=simple
WorkingDirectory=%h/RenCrow/RenCrow_PORTAL
ExecStart=%h/.local/bin/rencrow-portal --config %h/.rencrow/config/portal.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
